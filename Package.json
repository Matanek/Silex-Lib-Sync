{
  "name": "Sync",
  "version": "0.1.0",
  "description": "Persistent communication and shared-state synchronization for games and interactive applications.",
  "authors": ["Matanek"],
  "requires": {
    "silex": ">=0.39.0"
  },
  "dependencies": {
    "STD": "^0.19.0"
  },
  "boundary": {
    "macos-arm64": {
      "providers": {
        "SecureCrypto": {
          "archive": "Boundary/macos-arm64/libSecureCrypto.a"
        }
      }
    },
    "linux-x64": {
      "providers": {
        "SecureCrypto": {
          "archive": "Boundary/linux-x64/libSecureCrypto.a"
        }
      }
    },
    "windows-x64": {
      "providers": {
        "SecureCrypto": {
          "archive": "Boundary/windows-x64/SecureCrypto.lib"
        }
      }
    },
    "windows-arm64": {
      "providers": {
        "SecureCrypto": {
          "archive": "Boundary/windows-arm64/SecureCrypto.lib"
        }
      }
    }
  }
}
