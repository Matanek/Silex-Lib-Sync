use Sync
use STD.Crypto as StandardCrypto
use STD.Crypto.ChaCha20Poly1305
use STD.Crypto.HKDF
use STD.Crypto.X25519

package struct KeyPair {
    let secret:uint8[32]
    let public_key:uint8[32]
}

package func key_pair(seed:@uint8[..]) Result<KeyPair, Sync.Error> {
    match X25519.key_pair(seed) {
        success(pair) => {
            return Result<KeyPair, Sync.Error>.success(KeyPair(
                secret:pair.secret,
                public_key:pair.public_key
            ))
        }
        failure(error) => {
            return Result<KeyPair, Sync.Error>.failure(cryptography_error(
                "sync.secure.key_pair",
                error.detail
            ))
        }
    }
    panic("Sync secure key pair result was not handled")
}

package func shared_secret(
    secret:@uint8[..],
    peer_public_key:@uint8[..]
) Result<uint8[32], Sync.Error> {
    match X25519.shared_secret(secret, peer_public_key) {
        success(value) => { return Result<uint8[32], Sync.Error>.success(value) }
        failure(error) => {
            return Result<uint8[32], Sync.Error>.failure(Sync.failure(
                Sync.ErrorKind.authentication,
                "sync.secure.shared_secret",
                null,
                error.detail
            ))
        }
    }
    panic("Sync secure shared secret result was not handled")
}

package func derive(
    input:@uint8[..],
    salt:@uint8[..],
    context:@uint8[..],
    output_count:int
) Result<uint8[], Sync.Error> {
    match HKDF.derive_sha256(input, salt, context, output_count) {
        success(value) => { return Result<uint8[], Sync.Error>.success(value) }
        failure(error) => {
            return Result<uint8[], Sync.Error>.failure(cryptography_error(
                "sync.secure.derive",
                error.detail
            ))
        }
    }
    panic("Sync secure derivation result was not handled")
}

package func seal(
    key:@uint8[..],
    nonce:@uint8[..],
    associated:@uint8[..],
    message:@uint8[..]
) Result<uint8[], Sync.Error> {
    match ChaCha20Poly1305.seal(key, nonce, associated, message) {
        success(value) => { return Result<uint8[], Sync.Error>.success(value) }
        failure(error) => {
            return Result<uint8[], Sync.Error>.failure(cryptography_error(
                "sync.secure.seal",
                error.detail
            ))
        }
    }
    panic("Sync secure seal result was not handled")
}

package func open(
    key:@uint8[..],
    nonce:@uint8[..],
    associated:@uint8[..],
    sealed:@uint8[..]
) Result<uint8[], Sync.Error> {
    match ChaCha20Poly1305.open(key, nonce, associated, sealed) {
        success(value) => { return Result<uint8[], Sync.Error>.success(value) }
        failure(error) => {
            if error.kind == StandardCrypto.ErrorKind.authentication_failed {
                return Result<uint8[], Sync.Error>.failure(Sync.failure(
                    Sync.ErrorKind.authentication,
                    "sync.secure.open",
                    null,
                    error.detail
                ))
            }
            return Result<uint8[], Sync.Error>.failure(cryptography_error(
                "sync.secure.open",
                error.detail
            ))
        }
    }
    panic("Sync secure open result was not handled")
}

func cryptography_error(operation:str, detail:str) Sync.Error {
    return Sync.failure(Sync.ErrorKind.cryptography, operation, null, detail)
}
