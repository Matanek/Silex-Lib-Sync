use STD.Text.UTF8
use STD.Error as StandardError

public enum ErrorKind {
    invalid_configuration
    network
    timeout
    closed
    malformed_message
    unsupported_version
    message_limit
    resource_limit
    invalid_text
}

public struct Error {
    let kind:ErrorKind
    let operation:str
    let subject:str?
    let detail:str
}

public struct Message {
    let channel:uint16
    let payload:uint8[]

    func text() Result<str, Error> {
        if self.payload.is_empty() { return Result<str, Error>.success("") }
        match UTF8.decode(@self.payload[0:self.payload.count()]) {
            success(value) => { return Result<str, Error>.success(value) }
            failure(error) => {
                return Result<str, Error>.failure(failure(
                    ErrorKind.invalid_text,
                    "sync.message.text",
                    null,
                    "message payload is not valid UTF-8 at byte $(error.byte_offset)"
                ))
            }
        }
    }
}

package func failure(kind:ErrorKind, operation:str, subject:str?, detail:str) Error {
    return Error(kind:kind, operation:operation, subject:subject, detail:detail)
}

package func network_failure(operation:str, error:StandardError) Error {
    var kind = ErrorKind.network
    if error.kind == StandardError.Kind.timed_out || error.kind == StandardError.Kind.would_block {
        kind = ErrorKind.timeout
    } elif error.kind == StandardError.Kind.unexpected_end ||
        error.kind == StandardError.Kind.broken_pipe ||
        error.kind == StandardError.Kind.connection_aborted ||
        error.kind == StandardError.Kind.connection_reset ||
        error.kind == StandardError.Kind.not_connected {
        kind = ErrorKind.closed
    }
    return failure(kind, operation, error.subject, error.detail)
}
